# OpenAI API token (required for image descriptions)
OPENAI_API_TOKEN=sk-your-token-here

# Optional: Route OpenAI calls through an LLM gateway/proxy
# Must start with http:// or https://
# OPENAI_BASE_URL=http://llm-gateway:8100/v1

# Optional: Override the vision model (default: gpt-4o-mini)
# OPENAI_VISION_MODEL=gpt-4o-mini

# Data storage directory (default: /data)
# DATA_DIR=/data

# Maximum upload size in bytes (default: 500MB)
# MAX_UPLOAD_SIZE=524288000

# Max parallel OpenAI API calls for image descriptions (default: 5)
# MAX_CONCURRENT_DESCRIPTIONS=5

# Retry attempts for failed image descriptions (default: 3)
# DESCRIPTION_MAX_RETRIES=3

# Base delay in seconds for exponential backoff (default: 1.0)
# DESCRIPTION_RETRY_DELAY=1.0
